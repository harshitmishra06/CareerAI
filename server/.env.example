# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Database (For Phase 2)
MONGODB_URI=mongodb://localhost:27017/careerai

# Security & JWT
JWT_SECRET=super_secret_jwt_access_key_careerai_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_jwt_refresh_key_careerai_2026
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_EXPIRES_IN_DAYS=7
COOKIE_SAME_SITE=none # Use 'none' for cross-domain deployments (requires HTTPS/secure:true), or 'lax' for same-domain

# Admin Account Seed (Used exclusively by seed:admin script)
ADMIN_NAME=CareerAI Platform Admin
ADMIN_EMAIL=admin@careerai.local
ADMIN_PASSWORD=change_this_secure_admin_password_in_production

# AI Configuration (Phase 7 - AI Resume Analyzer: Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cloud Storage (Phase 6 - Mandatory in production; development allows local fallback)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_FILE_SIZE_MB=5